# Copy to .env and fill in from https://myapi.fyers.in/dashboard
# .env is gitignored -- never commit real credentials.

# App ID shown on the Fyers API dashboard, e.g. ABCD1234-100
FYERS_CLIENT_ID=
# App secret shown on the same dashboard
FYERS_SECRET_KEY=
# Must match the redirect URL registered for the app exactly
FYERS_REDIRECT_URI=https://127.0.0.1:8080/
# Filled in automatically by `python -m fyers_client.cli login`
FYERS_ACCESS_TOKEN=

# --- Unattended TOTP login (optional) -------------------------------------
# Set these three and the client logs in with no browser at all: it falls back
# to a full TOTP login whenever the cached and refresh tokens are both dead.
# FYERS_TOTP_SECRET is the base32 secret shown when you enable TOTP on your
# Fyers account -- not a 6-digit code. Treat this file as a 2FA seed store.
FYERS_ID=
FYERS_PIN=
FYERS_TOTP_SECRET=

# --- Endpoint overrides (optional) ----------------------------------------
# The login endpoints below are undocumented internals; override them here if
# Fyers moves them, rather than editing code.
# FYERS_LOGIN_BASE=https://api-t1.fyers.in/api/v3
# FYERS_SEND_OTP_URL=
# FYERS_VERIFY_OTP_URL=
# FYERS_VERIFY_PIN_URL=
# FYERS_TOKEN_URL=
